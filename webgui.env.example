# Copy these values into the environment used by your process manager.
WEBBUDDY_ADMIN_USERNAME=admin@local.com
WEBBUDDY_ADMIN_PASSWORD=replace-this-before-public-deployment
WEBBUDDY_DATA_DIR=/var/lib/webbuddy
WEBBUDDY_SECURE_COOKIE=true
WEBBUDDY_SESSION_EXPIRY=86400
WEBBUDDY_ACCOUNT_SYNC_INTERVAL=300
